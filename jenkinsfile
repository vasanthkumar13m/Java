pipeline {
    agent any

    tools {
        maven 'maven'
    }

    stages {
        stage('Checkout'){
            steps {
                git branch: 'feature/branch1', credentialsId: 'github', url: 'https://github.com/vasanthkumar13m/Java.git' 
            }
        }
        stage('Build') {
            steps {
                dir('java-jasper') {
                    sh 'mvn clean package'
                }
            }
        }   
        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'java-jasper/target/*.jar', fingerprint: true
            }
        }
        stage('Deploy To EC2') {
            steps {
                sshPublisher(publishers: [sshPublisherDesc(configName: 'ec2-instance', transfers: [sshTransfer(sourceFiles: 'java-jasper/target/*.jar', removePrefix: 'java-jasper/target', remoteDirectory:'/app')])])
            }
        }
    }
}